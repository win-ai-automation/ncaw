# Copy to .env and replace every CHANGE_ME value.
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
N8N_ENCRYPTION_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Bangkok

# Used by the starter workflow. Keep .env private.
CONTENT_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET
N8N_CONTENT_WEBHOOK_URL=https://YOUR_N8N_HOST/webhook/content-submit
N8N_PUBLISH_WEBHOOK_URL=https://YOUR_N8N_HOST/webhook/content-publish
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini

# Optional platform extractors. Leave blank to use the Jina fallback.
# Values use the Apify actor form owner/actor-name.
APIFY_ACTOR_FACEBOOK=
APIFY_ACTOR_YOUTUBE=
APIFY_ACTOR_LINKEDIN=
APIFY_ACTOR_INSTAGRAM=
APIFY_ACTOR_THREADS=
APIFY_ACTOR_TIKTOK=
APIFY_ACTOR_X=

# Supabase — application data and employee authentication.
# The publishable key is safe in the browser only because every table uses RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=CHANGE_ME_SUPABASE_PUBLISHABLE_KEY
# Server-only. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=CHANGE_ME_SUPABASE_SECRET_KEY

# Add these only after the review flow is accepted.
GHL_ACCESS_TOKEN=
GHL_LOCATION_ID=
GHL_USER_ID=
GHL_ACCOUNT_IDS=
GHL_SOCIAL_ACCOUNTS_JSON=[{"id":"facebook_account_id","name":"GBO CPA","platform":"facebook"},{"id":"linkedin_account_id","name":"NetFintax","platform":"linkedin"}]
PUBLISH_TIMEZONE=America/Los_Angeles
SLACK_REVIEW_WEBHOOK_URL=

